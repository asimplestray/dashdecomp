#!/usr/bin/env bash
# armcc via Wine - builds disponiveis em tools/rvct/
# Selecione com RVCT_BUILD=b821 (padrao: b902)
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
BUILD="${RVCT_BUILD:-b902}"
EXE="$HERE/../rvct/$BUILD/bin/armcc.exe"

if [ ! -f "$EXE" ]; then
    echo "ERRO: $EXE nao existe. Builds disponiveis:" >&2
    ls "$HERE/../rvct/" >&2
    exit 1
fi

export WINEDEBUG=-all
exec wine "$EXE" "$@"
